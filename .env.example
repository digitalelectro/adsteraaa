# Path to your downloaded service account JSON key
GOOGLE_APPLICATION_CREDENTIALS="/absolute/path/to/vertex-sa.json"

# Defaults for the Streamlit sidebar (you can also use VERTEX_* names)
PROJECT_ID="your-gcp-project-id"
LOCATION="us-central1"
# Optional model overrides (else defaults are used)
VERTEX_TEXT_MODEL="gemini-1.5-pro-002"
VERTEX_IMAGE_MODEL="imagegeneration@006"
